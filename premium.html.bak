        <div class="footer-col footer-news">
          <h4>Stay Inspired</h4>
          <p>Get weekly motion ideas and new feature announcements. No spam, ever.</p>
          <form class="news-form">
            <input type="email" placeholder="Your email address" required>
            <button type="submit" aria-label="Subscribe">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </button>
          </form>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© <span class="year">2025</span> ImagineAI. All rights reserved.</span>
        <div class="fb-links">
          <a href="#">Privacy Policy</a>
          <a href="#">Terms of Service</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- ===== Upgrade Modal ===== -->
  <div class="modal-overlay" id="modalOverlay">
    <div class="modal">
      <button class="modal-close" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
      <div class="m-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8l4 4 5-7 5 7 4-4-2 12H5L3 8z"/></svg>
      </div>
      <h3 class="m-title">Free limit reached!</h3>
      <p class="m-text">You have used all 5 free videos. Upgrade to keep turning your images into unlimited AI videos.</p>
      <a href="premium.html" class="btn btn-primary btn-block btn-lg">View Premium Plans</a>
      <p class="m-note">🔒 Secure checkout · 7-day money-back · Instant activation</p>
    </div>
  </div>

  <!-- ===== Back to top ===== -->
  <button class="to-top" id="toTop" aria-label="Back to top">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
  </button>

  <script src="js/main.js"></script>
  <script src="js/generator.js"></script>
  <script src="js/offer.js"></script>
  <script>
    // Mark the user's current plan on the pricing page
    document.addEventListener('DOMContentLoaded', () => {
      const plan = localStorage.getItem('imagineai_plan') || 'free';
      document.querySelectorAll('.price-card').forEach(card => {
        const btn = card.querySelector('[data-buy]');
        if (btn && btn.dataset.buy === plan) {
          btn.disabled = true;
          btn.style.opacity = '0.6';
          btn.style.cursor = 'default';
          btn.innerHTML = '✓ Current Plan';
        }
      });
    });
  </script>
</body>
</html>
