

/* ============================================================
   ImagineAI — AI Image-to-Video Generator
   Premium Aurora Design System & Animations
   ============================================================ */

/* ---------- 1. CSS Variables ---------- */
:root {
  --bg: #05060f;
  --bg-soft: #0a0c1a;
  --bg-card: #0e1024;
  --bg-card-hover: #161934;
  --border: rgba(255, 255, 255, 0.08);
  --border-strong: rgba(255, 255, 255, 0.16);

  --text: #f2f2f8;
  --text-dim: #a0a0b8;
  --text-faint: #6b6b85;

  --violet: #7c5cff;
  --violet-soft: #a78fff;
  --cyan: #22d3ee;
  --pink: #818cf8;
  --green: #34d399;
  --gold: #d4af37;
  --gold-soft: #e6c46b;

  --grad-main: linear-gradient(135deg, #7c5cff 0%, #6366f1 45%, #22d3ee 100%);
  --grad-text: linear-gradient(100deg, #a78fff 0%, #22d3ee 50%, #818cf8 100%);
  --grad-btn: linear-gradient(135deg, #6d28d9 0%, #6366f1 50%, #0ea5e9 100%);

  --radius: 16px;
  --radius-sm: 10px;
  --radius-lg: 24px;

  --shadow-glow: 0 0 40px rgba(124, 92, 255, 0.35);
  --shadow-card: 0 10px 40px rgba(0, 0, 0, 0.45);

  --font-head: 'Space Grotesk', 'Segoe UI', sans-serif;
  --font-body: 'Inter', 'Segoe UI', sans-serif;

  --nav-h: 76px;
  --max-w: 1200px;
}

/* ---------- 2. Reset & Base ---------- */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  font-family: var(--font-body);
  background: var(--bg);
  color: var(--text);
  line-height: 1.65;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

/* aurora atmosphere — constant subtle glow behind every page */
body::before {
  content: '';
  position: fixed; inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse 70% 42% at 50% -12%, rgba(124, 92, 255, 0.1), transparent 62%),
    radial-gradient(ellipse 46% 32% at 92% 18%, rgba(34, 211, 238, 0.055), transparent 58%),
    radial-gradient(ellipse 40% 30% at 6% 78%, rgba(129, 140, 248, 0.05), transparent 60%);
}

img, canvas { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }
button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }
input, select, textarea { font-family: inherit; }
ul { list-style: none; }

::selection { background: rgba(124, 92, 255, 0.45); color: #fff; }

/* Scrollbar */
::-webkit-scrollbar { width: 10px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, #6d28d9, #0ea5e9);
  border-radius: 8px;
  border: 2px solid var(--bg);
}

/* ---------- 3. Utilities ---------- */
.container { width: min(var(--max-w), 92%); margin-inline: auto; }

.section { padding: 110px 0; position: relative; }
.section-alt { background: var(--bg-soft); }
.section-alt::before {
  content: '';
  position: absolute; inset: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse 55% 45% at 12% 15%, rgba(124, 92, 255, 0.06), transparent 60%),
    radial-gradient(ellipse 45% 40% at 88% 85%, rgba(34, 211, 238, 0.045), transparent 60%);
}
.section-alt > .container { position: relative; z-index: 1; }

.grad-text {
  background: var(--grad-text);
  background-size: 200% auto;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
  animation: gradientShift 6s ease infinite;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--violet-soft);
  padding: 8px 18px;
  border: 1px solid rgba(124, 92, 255, 0.4);
  border-radius: 999px;
  background: rgba(124, 92, 255, 0.08);
  margin-bottom: 18px;
}
.eyebrow::before {
  content: '';
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--cyan);
  box-shadow: 0 0 12px var(--cyan);
  animation: pulseGlow 2s ease infinite;
}

.section-head { text-align: center; max-width: 680px; margin: 0 auto 64px; }
.section-head h2 {
  font-family: var(--font-head);
  font-size: clamp(1.9rem, 4vw, 2.8rem);
  font-weight: 700;
  line-height: 1.15;
  margin-bottom: 14px;
}
.section-head p { color: var(--text-dim); font-size: 1.05rem; }

/* ---------- 4. Buttons ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 15px 34px;
  font-size: 1rem;
  font-weight: 600;
  border-radius: 999px;
  transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  position: relative;
  overflow: hidden;
  white-space: nowrap;
}
.btn svg { width: 18px; height: 18px; flex-shrink: 0; }

.btn-primary {
  background: var(--grad-btn);
  background-size: 200% auto;
  color: #fff;
  box-shadow: 0 8px 30px rgba(91, 140, 255, 0.4);
}
.btn-primary:hover {
  background-position: right center;
  transform: translateY(-3px);
  box-shadow: 0 14px 44px rgba(91, 140, 255, 0.55);
}
.btn-primary:active { transform: translateY(-1px); }

/* shine sweep effect */
.btn-primary::after {
  content: '';
  position: absolute;
  top: 0; left: -80%;
  width: 50%; height: 100%;
  background: linear-gradient(100deg, transparent, rgba(255,255,255,0.35), transparent);
  transform: skewX(-20deg);
  animation: shine 3.5s ease infinite;
}

.btn-ghost {
  border: 1px solid var(--border-strong);
  color: var(--text);
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(8px);
}
.btn-ghost:hover {
  border-color: var(--violet);
  color: var(--violet-soft);
  transform: translateY(-3px);
  box-shadow: 0 10px 30px rgba(124, 92, 255, 0.2);
}

.btn-sm { padding: 11px 24px; font-size: 0.9rem; }
.btn-lg { padding: 18px 44px; font-size: 1.08rem; }
.btn-block { width: 100%; }

/* ---------- 5. Preloader ---------- */
#preloader {
  position: fixed; inset: 0;
  background: var(--bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22px;
  z-index: 9999;
  transition: opacity 0.6s ease, visibility 0.6s ease;
}
#preloader.hidden { opacity: 0; visibility: hidden; pointer-events: none; }
.loader-ring {
  width: 70px; height: 70px;
  border-radius: 50%;
  border: 3px solid rgba(124, 92, 255, 0.15);
  border-top-color: var(--violet);
  border-right-color: var(--cyan);
  animation: spin 0.9s linear infinite;
}
.loader-text {
  font-family: var(--font-head);
  font-weight: 700;
  letter-spacing: 3px;
  font-size: 0.85rem;
  text-transform: uppercase;
  animation: pulseGlow 1.6s ease infinite;
}

/* ---------- 6. Navbar ---------- */
.navbar {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: var(--nav-h);
  z-index: 1000;
  transition: all 0.4s ease;
}
.navbar.scrolled {
  background: rgba(5, 6, 15, 0.75);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--border);
  height: 66px;
}
.nav-inner {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}
.logo {
  display: flex;
  align-items: center;
  gap: 11px;
  font-family: var(--font-head);
  font-size: 1.4rem;
  font-weight: 700;
  letter-spacing: -0.5px;
}
.logo-mark {
  width: 40px; height: 40px;
  border-radius: 12px;
  background: var(--grad-main);
  display: grid;
  place-items: center;
  box-shadow: 0 0 22px rgba(124, 92, 255, 0.55);
  animation: float 4s ease-in-out infinite;
}
.logo-mark svg { width: 22px; height: 22px; color: #fff; }
.logo span em { font-style: normal; }

.nav-links {
  display: flex;
  align-items: center;
  gap: 6px;
}
.nav-links a {
  padding: 9px 18px;
  border-radius: 999px;
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--text-dim);
  transition: all 0.3s ease;
  position: relative;
}
.nav-links a:hover { color: var(--text); background: rgba(255,255,255,0.05); }
.nav-links a.active {
  color: #fff;
  background: rgba(124, 92, 255, 0.16);
  border: 1px solid rgba(124, 92, 255, 0.35);
}

.nav-cta { display: flex; align-items: center; gap: 14px; }

.plan-badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  padding: 7px 16px;
  border-radius: 999px;
  color: var(--gold-soft);
  border: 1px solid rgba(212, 175, 55, 0.45);
  background: rgba(212, 175, 55, 0.1);
}
.plan-badge.pro {
  color: var(--gold-soft);
  border-color: rgba(212, 175, 55, 0.6);
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.18), rgba(212, 175, 55, 0.06));
  box-shadow: 0 0 18px rgba(212, 175, 55, 0.3);
}
.plan-badge.free { color: var(--cyan); border-color: rgba(34,211,238,0.4); background: rgba(34,211,238,0.08); }

.hamburger {
  display: none;
  width: 44px; height: 44px;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: rgba(255,255,255,0.04);
  place-items: center;
  z-index: 1002;
}
.hamburger span {
  display: block;
  width: 20px; height: 2px;
  background: var(--text);
  border-radius: 2px;
  position: relative;
  transition: all 0.3s ease;
}
.hamburger span::before, .hamburger span::after {
  content: '';
  position: absolute;
  left: 0; width: 20px; height: 2px;
  background: var(--text);
  border-radius: 2px;
  transition: all 0.3s ease;
}
.hamburger span::before { top: -6px; }
.hamburger span::after { top: 6px; }
.hamburger.open span { background: transparent; }
.hamburger.open span::before { top: 0; transform: rotate(45deg); }
.hamburger.open span::after { top: 0; transform: rotate(-45deg); }

/* ---------- 7. Hero ---------- */
.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  position: relative;
  padding: calc(var(--nav-h) + 60px) 0 90px;
  overflow: hidden;
}
.hero-bg { position: absolute; inset: 0; pointer-events: none; }

.grid-pattern {
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(124, 92, 255, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(124, 92, 255, 0.05) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: radial-gradient(ellipse 80% 65% at 50% 40%, #000 30%, transparent 75%);
  -webkit-mask-image: radial-gradient(ellipse 80% 65% at 50% 40%, #000 30%, transparent 75%);
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(90px);
  opacity: 0.5;
  animation: float 9s ease-in-out infinite;
}
.orb-1 { width: 480px; height: 480px; background: rgba(109, 40, 217, 0.4); top: -140px; left: -120px; }
.orb-2 { width: 420px; height: 420px; background: rgba(13, 148, 136, 0.32); bottom: -160px; right: -100px; animation-delay: -3s; }
.orb-3 { width: 300px; height: 300px; background: rgba(129, 140, 248, 0.25); top: 40%; right: 22%; animation-delay: -6s; }

.hero-inner {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 60px;
  align-items: center;
}
.hero-copy .eyebrow { margin-bottom: 26px; }
.hero-title {
  font-family: var(--font-head);
  font-size: clamp(2.5rem, 5.6vw, 4.3rem);
  font-weight: 700;
  line-height: 1.08;
  letter-spacing: -1.5px;
  margin-bottom: 24px;
}
.hero-sub {
  font-size: 1.12rem;
  color: var(--text-dim);
  max-width: 540px;
  margin-bottom: 36px;
}
.hero-actions { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 46px; }

.hero-stats {
  display: flex;
  gap: 44px;
  flex-wrap: wrap;
}
.hero-stat .num {
  font-family: var(--font-head);
  font-size: 1.9rem;
  font-weight: 700;
  background: var(--grad-text);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
.hero-stat .lbl { font-size: 0.85rem; color: var(--text-faint); }

/* Hero visual — floating prompt card */
.hero-visual { position: relative; min-height: 440px; }
.float-card {
  position: absolute;
  background: rgba(13, 13, 26, 0.75);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 22px;
  backdrop-filter: blur(14px);
  box-shadow: var(--shadow-card);
  animation: float 6s ease-in-out infinite;
}
.fc-main {
  width: 88%;
  top: 0; right: 0;
  animation-delay: -2s;
}
.fc-main .fc-img {
  aspect-ratio: 4/3;
  border-radius: var(--radius);
  overflow: hidden;
  margin-bottom: 16px;
}
.fc-tag {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--cyan);
  padding: 6px 14px;
  border-radius: 999px;
  background: rgba(34, 211, 238, 0.1);
  border: 1px solid rgba(34, 211, 238, 0.3);
}
.fc-prompt {
  font-size: 0.9rem;
  color: var(--text-dim);
  margin-top: 12px;
  display: flex;
  gap: 8px;
  align-items: center;
}
.fc-prompt svg { width: 15px; height: 15px; color: var(--violet-soft); flex-shrink: 0; }

.fc-side {
  width: 46%;
  bottom: 6%;
  left: 0;
  padding: 18px;
  animation-delay: -4s;
}
.fc-side .fc-img {
  aspect-ratio: 1/1;
  border-radius: var(--radius);
  overflow: hidden;
  margin-bottom: 12px;
}
.fc-side .fc-stats { display: flex; gap: 14px; font-size: 0.78rem; color: var(--text-faint); }
.fc-side .fc-stats b { color: var(--green); }

.fc-badge {
  position: absolute;
  top: 8%; left: -4%;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(13, 13, 26, 0.9);
  border: 1px solid rgba(52, 211, 153, 0.4);
  padding: 12px 18px;
  border-radius: 14px;
  font-size: 0.85rem;
  font-weight: 600;
  box-shadow: var(--shadow-card);
  animation: float 5s ease-in-out infinite;
  animation-delay: -1s;
}
.fc-badge .dot {
  width: 10px; height: 10px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 12px var(--green);
  animation: pulseGlow 1.8s ease infinite;
}

/* ---------- 8. Generator ---------- */
.generator-wrap {
  display: grid;
  grid-template-columns: 1fr 1.15fr;
  gap: 34px;
  align-items: stretch;
}
.gen-panel {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 30px;
  position: relative;
  overflow: hidden;
}
.gen-panel::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: var(--grad-main);
  background-size: 200% auto;
  animation: gradientShift 5s ease infinite;
}

.gen-label {
  display: block;
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  color: var(--text-faint);
  margin-bottom: 10px;
}
.gen-field { margin-bottom: 22px; }

.gen-input {
  width: 100%;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--text);
  padding: 15px 18px;
  font-size: 0.98rem;
  transition: all 0.3s ease;
  resize: vertical;
}
.gen-input::placeholder { color: var(--text-faint); }
.gen-input:focus {
  outline: none;
  border-color: var(--violet);
  box-shadow: 0 0 0 3px rgba(124, 92, 255, 0.2), 0 0 24px rgba(124, 92, 255, 0.15);
  background: rgba(255, 255, 255, 0.06);
}

.gen-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
select.gen-input { appearance: none; cursor: pointer; }
.select-wrap { position: relative; }
.select-wrap::after {
  content: '▾';
  position: absolute;
  right: 16px; top: 50%;
  transform: translateY(-50%);
  color: var(--text-faint);
  pointer-events: none;
}
.select-wrap select { padding-right: 40px; }
.select-wrap select option { background: var(--bg-card); color: var(--text); }

.credits-chip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 13px 18px;
  border-radius: var(--radius-sm);
  border: 1px dashed rgba(124, 92, 255, 0.45);
  background: rgba(124, 92, 255, 0.06);
  margin-bottom: 22px;
  font-size: 0.9rem;
}
.credits-chip .free-left { font-weight: 700; color: var(--cyan); }
.credits-chip a { color: var(--violet-soft); font-weight: 600; border-bottom: 1px dashed var(--violet-soft); }
.credits-chip a:hover { color: var(--violet); }
.credits-chip .unlimited { font-weight: 700; color: var(--amber); }

/* Output side */
.gen-output-panel {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 30px;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}
.gen-output-frame {
  flex: 1;
  min-height: 380px;
  border-radius: var(--radius);
  border: 1px dashed var(--border-strong);
  background:
    radial-gradient(circle at 30% 20%, rgba(124, 92, 255, 0.08), transparent 55%),
    radial-gradient(circle at 75% 80%, rgba(34, 211, 238, 0.08), transparent 55%),
    rgba(0, 0, 0, 0.25);
  display: grid;
  place-items: center;
  position: relative;
  overflow: hidden;
  transition: border-color 0.4s ease;
}
.gen-output-frame.has-image { border-style: solid; border-color: rgba(124, 92, 255, 0.4); }

.gen-placeholder { text-align: center; padding: 30px; color: var(--text-faint); }
.gen-placeholder .ph-icon {
  width: 74px; height: 74px;
  margin: 0 auto 18px;
  border-radius: 22px;
  background: rgba(124, 92, 255, 0.1);
  border: 1px solid rgba(124, 92, 255, 0.3);
  display: grid;
  place-items: center;
  animation: float 4s ease-in-out infinite;
}
.gen-placeholder .ph-icon svg { width: 32px; height: 32px; color: var(--violet-soft); }
.gen-placeholder p { max-width: 300px; font-size: 0.92rem; }

.gen-canvas { width: 100%; height: 100%; object-fit: cover; border-radius: var(--radius); animation: fadeScale 0.7s ease; }

/* generation loading state */
.gen-loading { position: absolute; inset: 0; display: none; z-index: 5; }
.gen-loading.active { display: flex; }
.loading-overlay {
  position: absolute; inset: 0;
  background: rgba(5, 6, 15, 0.75);
  backdrop-filter: blur(6px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20px;
  padding: 30px;
  text-align: center;
}
.loading-orb {
  width: 66px; height: 66px;
  border-radius: 50%;
  background: conic-gradient(from 0deg, var(--violet), var(--cyan), var(--pink), var(--violet));
  animation: spin 1.4s linear infinite;
  box-shadow: var(--shadow-glow);
  position: relative;
}
.loading-orb::after {
  content: '';
  position: absolute; inset: 8px;
  border-radius: 50%;
  background: var(--bg);
}
.stage-text {
  font-family: var(--font-head);
  font-weight: 600;
  font-size: 1.05rem;
  min-height: 26px;
}
.stage-text .cursor { display: inline-block; width: 2px; height: 18px; background: var(--cyan); animation: blink 0.9s step-end infinite; vertical-align: -3px; margin-left: 4px; }
.stage-bar {
  width: min(320px, 80%);
  height: 6px;
  border-radius: 99px;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}
.stage-bar i {
  display: block;
  height: 100%;
  width: 0%;
  border-radius: 99px;
  background: var(--grad-main);
  background-size: 200% auto;
  animation: gradientShift 2s linear infinite;
  transition: width 0.5s ease;
}

.gen-hint {
  margin-top: 16px;
  font-size: 0.82rem;
  color: var(--text-faint);
  text-align: center;
}
.gen-hint a { color: var(--cyan); border-bottom: 1px dashed rgba(34, 211, 238, 0.5); }

/* ---------- 9. Feature cards ---------- */
.features-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 26px;
}
.feature-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 34px 30px;
  transition: all 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  position: relative;
  overflow: hidden;
}
.feature-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 20% 0%, rgba(124, 92, 255, 0.14), transparent 60%);
  opacity: 0;
  transition: opacity 0.45s ease;
}
.feature-card:hover {
  transform: translateY(-9px);
  border-color: rgba(124, 92, 255, 0.45);
  box-shadow: 0 22px 55px rgba(0, 0, 0, 0.5), 0 0 34px rgba(124, 92, 255, 0.14);
}
.feature-card:hover::before { opacity: 1; }
.feature-icon {
  width: 58px; height: 58px;
  border-radius: 16px;
  background: rgba(124, 92, 255, 0.12);
  border: 1px solid rgba(124, 92, 255, 0.35);
  display: grid;
  place-items: center;
  margin-bottom: 22px;
  transition: all 0.4s ease;
}
.feature-icon svg { width: 26px; height: 26px; color: var(--violet-soft); }
.feature-card:hover .feature-icon {
  background: var(--grad-main);
  box-shadow: var(--shadow-glow);
  transform: scale(1.08) rotate(-4deg);
}
.feature-card:hover .feature-icon svg { color: #fff; }
.feature-card h3 {
  font-family: var(--font-head);
  font-size: 1.22rem;
  margin-bottom: 10px;
}
.feature-card p { color: var(--text-dim); font-size: 0.94rem; }

/* ---------- 10. How it works ---------- */
.steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
  counter-reset: step;
}
.step-card {
  position: relative;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 40px 30px 32px;
  text-align: center;
  transition: all 0.4s ease;
}
.step-card:hover { transform: translateY(-7px); border-color: rgba(34, 211, 238, 0.45); }
.step-num {
  width: 52px; height: 52px;
  margin: 0 auto 20px;
  border-radius: 50%;
  background: var(--grad-main);
  display: grid;
  place-items: center;
  font-family: var(--font-head);
  font-weight: 700;
  font-size: 1.2rem;
  color: #fff;
  box-shadow: var(--shadow-glow);
  position: relative;
}
.step-card h3 { font-family: var(--font-head); margin-bottom: 10px; font-size: 1.15rem; }
.step-card p { color: var(--text-dim); font-size: 0.92rem; }
.step-arrow {
  position: absolute;
  top: 58px;
  right: -22px;
  color: var(--text-faint);
  width: 26px; height: 26px;
  z-index: 2;
  animation: arrowNudge 2.2s ease infinite;
}

/* ---------- 11. Gallery ---------- */
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
.gallery-item {
  border-radius: var(--radius);
  overflow: hidden;
  position: relative;
  cursor: pointer;
  border: 1px solid var(--border);
  transition: all 0.4s ease;
  aspect-ratio: 1/1;
}
.gallery-item:hover {
  transform: translateY(-7px) scale(1.02);
  border-color: rgba(124, 92, 255, 0.5);
  box-shadow: 0 18px 45px rgba(0, 0, 0, 0.5), 0 0 30px rgba(124, 92, 255, 0.18);
  z-index: 2;
}
.gallery-item .art { width: 100%; height: 100%; }
.gallery-item .g-cap {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  padding: 34px 16px 14px;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.85));
  font-size: 0.82rem;
  font-weight: 500;
  transform: translateY(8px);
  opacity: 0.9;
  transition: all 0.35s ease;
}
.gallery-item:hover .g-cap { transform: translateY(0); opacity: 1; }

/* procedural art tiles (pure CSS) */
.art { position: relative; overflow: hidden; }
.art-1 { background: linear-gradient(140deg, #1e1b4b 0%, #6d28d9 45%, #a5b4fc 100%); }
.art-1::before {
  content: '';
  position: absolute; inset: -30%;
  background: radial-gradient(circle at 65% 30%, rgba(255,255,255,0.85) 0%, transparent 40%),
              radial-gradient(circle at 30% 75%, rgba(34,211,238,0.7) 0%, transparent 45%);
  animation: blob 9s ease-in-out infinite alternate;
}
.art-2 { background: linear-gradient(160deg, #052e2b 0%, #0e7490 50%, #a5f3fc 100%); }
.art-2::before {
  content: '';
  position: absolute; inset: -20%;
  background:
    radial-gradient(ellipse at 40% 60%, rgba(16,185,129,0.75) 0%, transparent 42%),
    radial-gradient(ellipse at 75% 25%, rgba(255,255,255,0.65) 0%, transparent 35%);
  animation: blob 11s ease-in-out infinite alternate-reverse;
}
.art-3 { background: linear-gradient(135deg, #4a044e 0%, #be185d 50%, #fdba74 100%); }
.art-3::before {
  content: '';
  position: absolute; inset: -25%;
  background:
    radial-gradient(circle at 30% 30%, rgba(253,224,71,0.85) 0%, transparent 38%),
    radial-gradient(circle at 70% 70%, rgba(255,255,255,0.5) 0%, transparent 40%);
  animation: blob 8s ease-in-out infinite alternate;
}
.art-4 { background: linear-gradient(150deg, #0c0a1d 0%, #312e81 50%, #22d3ee 100%); }
.art-4::before {
  content: '';
  position: absolute; inset: -30%;
  background:
    conic-gradient(from 200deg at 55% 45%, transparent 0deg, rgba(255,255,255,0.8) 60deg, transparent 120deg),
    radial-gradient(circle at 70% 65%, rgba(124,92,255,0.8) 0%, transparent 45%);
  animation: spin 18s linear infinite;
}
.art-5 { background: linear-gradient(120deg, #3b0764 0%, #7c5cff 55%, #67e8f9 100%); }
.art-5::before {
  content: '';
  position: absolute; inset: -20%;
  background:
    radial-gradient(ellipse at 25% 70%, rgba(255,255,255,0.7) 0%, transparent 36%),
    radial-gradient(ellipse at 80% 20%, rgba(129,140,248,0.65) 0%, transparent 40%);
  animation: blob 10s ease-in-out infinite alternate-reverse;
}
.art-6 { background: linear-gradient(200deg, #172554 0%, #1d4ed8 50%, #93c5fd 100%); }
.art-6::before {
  content: '';
  position: absolute; inset: -25%;
  background:
    radial-gradient(circle at 50% 20%, rgba(255,255,255,0.9) 0%, transparent 30%),
    radial-gradient(circle at 60% 80%, rgba(14,165,233,0.8) 0%, transparent 45%);
  animation: blob 12s ease-in-out infinite alternate;
}
.art-7 { background: linear-gradient(145deg, #1c1917 0%, #b45309 45%, #fde68a 100%); }
.art-7::before {
  content: '';
  position: absolute; inset: -20%;
  background:
    radial-gradient(ellipse at 30% 35%, rgba(255,255,255,0.75) 0%, transparent 34%),
    radial-gradient(ellipse at 72% 72%, rgba(217,119,6,0.85) 0%, transparent 42%);
  animation: blob 9.5s ease-in-out infinite alternate-reverse;
}
.art-8 { background: linear-gradient(130deg, #022c22 0%, #059669 45%, #a7f3d0 100%); }
.art-8::before {
  content: '';
  position: absolute; inset: -25%;
  background:
    radial-gradient(circle at 70% 25%, rgba(255,255,255,0.8) 0%, transparent 36%),
    radial-gradient(circle at 25% 70%, rgba(52,211,153,0.75) 0%, transparent 42%);
  animation: blob 8.5s ease-in-out infinite alternate;
}

/* ---------- 12. Testimonials ---------- */
.testi-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 26px;
}
.testi-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 32px;
  transition: all 0.4s ease;
  position: relative;
}
.testi-card:hover { transform: translateY(-7px); border-color: rgba(129, 140, 248, 0.4); }
.testi-card .quote-mark {
  font-family: var(--font-head);
  font-size: 4rem;
  line-height: 1;
  background: var(--grad-text);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  opacity: 0.6;
  position: absolute;
  top: 18px; right: 24px;
}
.testi-stars { display: flex; gap: 4px; margin-bottom: 16px; color: var(--amber); }
.testi-stars svg { width: 16px; height: 16px; }
.testi-card blockquote { color: var(--text-dim); font-size: 0.95rem; margin-bottom: 24px; }
.testi-user { display: flex; align-items: center; gap: 14px; }
.testi-avatar {
  width: 48px; height: 48px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-weight: 700;
  font-size: 1rem;
  color: #fff;
}
.av-1 { background: linear-gradient(135deg, #7c5cff, #818cf8); }
.av-2 { background: linear-gradient(135deg, #0ea5e9, #34d399); }
.av-3 { background: linear-gradient(135deg, #f59e0b, #ef4444); }
.testi-user .who { font-weight: 600; font-size: 0.95rem; }
.testi-user .role { font-size: 0.8rem; color: var(--text-faint); }

/* ---------- 13. CTA banner ---------- */
.cta-banner {
  border-radius: var(--radius-lg);
  padding: 70px 50px;
  text-align: center;
  position: relative;
  overflow: hidden;
  background: var(--bg-card);
  border: 1px solid rgba(124, 92, 255, 0.35);
}
.cta-banner::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 60% 80% at 20% 0%, rgba(124, 92, 255, 0.25), transparent 60%),
    radial-gradient(ellipse 60% 80% at 80% 100%, rgba(34, 211, 238, 0.2), transparent 60%);
  pointer-events: none;
}
.cta-banner h2 {
  font-family: var(--font-head);
  font-size: clamp(1.8rem, 3.6vw, 2.6rem);
  margin-bottom: 16px;
  position: relative;
}
.cta-banner p { color: var(--text-dim); max-width: 520px; margin: 0 auto 34px; position: relative; }

/* ---------- 14. Page hero (sub pages) ---------- */
.page-hero {
  padding: calc(var(--nav-h) + 90px) 0 80px;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.page-hero h1 {
  font-family: var(--font-head);
  font-size: clamp(2.2rem, 5vw, 3.6rem);
  font-weight: 700;
  letter-spacing: -1px;
  margin-bottom: 18px;
}
.page-hero .page-sub {
  color: var(--text-dim);
  max-width: 620px;
  margin: 0 auto;
  font-size: 1.08rem;
}
.breadcrumb {
  margin-top: 26px;
  font-size: 0.85rem;
  color: var(--text-faint);
  display: flex;
  justify-content: center;
  gap: 8px;
}
.breadcrumb a { color: var(--violet-soft); }
.breadcrumb a:hover { color: var(--violet); }
.breadcrumb .sep { opacity: 0.5; }

/* ---------- 14b. Real images ---------- */
.fc-img { position: relative; }
.fc-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.gallery-item img {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}
.gallery-item:hover img { transform: scale(1.08); }
.preset-card { aspect-ratio: 1/1; }
.preset-card img {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}
.preset-card:hover img { transform: scale(1.08); }
.story-visual img {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  filter: saturate(1.1);
}
.story-visual::before { z-index: 1; opacity: 0.45; }
.story-visual .story-badge { z-index: 2; }
.team-avatar img, .testi-avatar img {
  width: 100%; height: 100%;
  object-fit: cover;
  border-radius: 50%;
  display: block;
}

/* ---------- 14c. Image-to-video: dropzone & samples ---------- */
.dropzone {
  border: 2px dashed rgba(124, 92, 255, 0.45);
  border-radius: var(--radius);
  padding: 34px 22px;
  text-align: center;
  cursor: pointer;
  background: rgba(255, 255, 255, 0.02);
  transition: all 0.35s ease;
  position: relative;
}
.dropzone:hover { border-color: var(--violet-soft); background: rgba(124, 92, 255, 0.05); }
.dropzone.dragover {
  border-color: var(--cyan);
  background: rgba(34, 211, 238, 0.08);
  box-shadow: 0 0 30px rgba(34, 211, 238, 0.25), inset 0 0 30px rgba(34, 211, 238, 0.06);
  transform: scale(1.015);
}
.dz-icon {
  width: 62px; height: 62px;
  margin: 0 auto 16px;
  border-radius: 18px;
  background: rgba(124, 92, 255, 0.12);
  border: 1px solid rgba(124, 92, 255, 0.35);
  display: grid;
  place-items: center;
  transition: all 0.35s ease;
}
.dropzone:hover .dz-icon { transform: translateY(-4px) rotate(-4deg); box-shadow: var(--shadow-glow); }
.dz-icon svg { width: 28px; height: 28px; color: var(--violet-soft); }
.dz-title { font-weight: 600; font-size: 0.98rem; margin-bottom: 4px; }
.dz-sub { color: var(--text-faint); font-size: 0.82rem; }

.dz-preview { position: relative; }
.dz-preview img {
  max-height: 230px;
  margin: 0 auto;
  border-radius: var(--radius-sm);
  border: 1px solid rgba(124, 92, 255, 0.4);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  animation: fadeScale 0.45s ease;
}
.dz-remove {
  position: absolute;
  top: 10px; right: 10px;
  width: 34px; height: 34px;
  border-radius: 50%;
  background: rgba(5, 6, 15, 0.72);
  border: 1px solid var(--border-strong);
  color: #fff;
  display: grid;
  place-items: center;
  transition: all 0.3s ease;
  backdrop-filter: blur(6px);
}
.dz-remove:hover { background: var(--pink); border-color: var(--pink); transform: rotate(90deg); }
.dz-remove svg { width: 14px; height: 14px; }

.sample-chips { display: flex; align-items: center; gap: 10px; margin-top: 16px; flex-wrap: wrap; }
.sample-chips .sc-label { font-size: 0.8rem; color: var(--text-faint); margin-right: 2px; }
.sample-chip {
  width: 56px; height: 56px;
  border-radius: 12px;
  overflow: hidden;
  border: 2px solid var(--border);
  padding: 0;
  transition: all 0.3s ease;
  position: relative;
}
.sample-chip img { width: 100%; height: 100%; object-fit: cover; }
.sample-chip:hover { transform: translateY(-4px); border-color: var(--cyan); box-shadow: 0 8px 22px rgba(34, 211, 238, 0.3); }
.sample-chip.active { border-color: var(--cyan); box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.25), 0 0 18px rgba(34, 211, 238, 0.5); }

/* ---------- 14d. Play overlay, duration badge, video output ---------- */
.play-overlay {
  position: absolute; inset: 0;
  display: grid;
  place-items: center;
  background: rgba(0, 0, 0, 0.12);
  z-index: 1;
  transition: background 0.35s ease;
}
.play-btn {
  width: 58px; height: 58px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.45);
  display: grid;
  place-items: center;
  color: #fff;
  transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  box-shadow: 0 8px 26px rgba(0, 0, 0, 0.35);
}
.play-btn svg { width: 22px; height: 22px; margin-left: 3px; }
.gallery-item:hover .play-btn, .preset-card:hover .play-btn {
  transform: scale(1.14);
  background: var(--grad-btn);
  border-color: transparent;
  box-shadow: var(--shadow-glow);
}
.dur-badge {
  position: absolute;
  bottom: 12px; right: 12px;
  background: rgba(0, 0, 0, 0.72);
  padding: 4px 10px;
  border-radius: 7px;
  font-size: 0.74rem;
  font-weight: 600;
  letter-spacing: 0.5px;
  z-index: 2;
  backdrop-filter: blur(4px);
}
.gallery-item .g-cap { z-index: 2; }

.gen-video {
  width: 100%; height: 100%;
  object-fit: cover;
  border-radius: var(--radius);
  animation: fadeScale 0.7s ease;
}

/* fake video progress bar on hero cards */
.fc-progress {
  height: 4px;
  border-radius: 99px;
  background: rgba(255, 255, 255, 0.1);
  overflow: hidden;
  margin: 12px 0 6px;
}
.fc-progress i {
  display: block;
  height: 100%;
  width: 40%;
  border-radius: 99px;
  background: var(--grad-main);
  background-size: 200% auto;
  animation: progressFill 3.4s ease-in-out infinite alternate, gradientShift 4s linear infinite;
}
@keyframes progressFill {
  from { width: 6%; }
  to { width: 88%; }
}

/* ---------- 14e. Ken Burns living thumbnails ---------- */
.kb img { animation: kenburns 18s ease-in-out infinite alternate; will-change: transform; }
.kb-1 img { animation-name: kbZoom; }
.kb-2 img { animation-name: kbPan; }
.kb-3 img { animation-name: kbOrbit; }
.kb-4 img { animation-name: kbZoomAlt; }
.kb-5 img { animation-name: kbPanAlt; }
.kb-6 img { animation-name: kbZoom; animation-duration: 14s; }
.kb-7 img { animation-name: kbOrbit; animation-duration: 22s; }
.kb-8 img { animation-name: kbPan; animation-duration: 16s; animation-direction: alternate-reverse; }
@keyframes kbZoom {
  from { transform: scale(1.02) translate(0, 0); }
  to { transform: scale(1.22) translate(1.5%, -1.5%); }
}
@keyframes kbZoomAlt {
  from { transform: scale(1.22) translate(-1%, 1%); }
  to { transform: scale(1.02) translate(0, 0); }
}
@keyframes kbPan {
  from { transform: scale(1.14) translate(-2.4%, 0.6%); }
  to { transform: scale(1.14) translate(2.4%, -0.6%); }
}
@keyframes kbPanAlt {
  from { transform: scale(1.14) translate(2%, 1%); }
  to { transform: scale(1.14) translate(-2%, -1%); }
}
@keyframes kbOrbit {
  from { transform: scale(1.12) rotate(-1.1deg); }
  to { transform: scale(1.18) rotate(1.1deg); }
}
/* live thumbnails replace the static hover-zoom */
.gallery-item:hover img { transform: none; }
.preset-card:hover img { transform: none; }
/* video-style badges on preset cards */
.preset-card .p-name { z-index: 2; padding-right: 88px; }
.preset-card .p-hot { z-index: 2; }
.preset-card .dur-badge { z-index: 2; }

/* ---------- 15. About page ---------- */
.about-story-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 60px;
  align-items: center;
}
.story-copy h2 { font-family: var(--font-head); font-size: clamp(1.7rem, 3.4vw, 2.4rem); margin-bottom: 20px; }
.story-copy p { color: var(--text-dim); margin-bottom: 18px; }
.story-visual {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 1px solid var(--border);
  min-height: 380px;
  background: linear-gradient(160deg, #1e1b4b, #0ea5e9);
}
.story-visual::before {
  content: '';
  position: absolute; inset: -25%;
  background:
    radial-gradient(circle at 30% 30%, rgba(255,255,255,0.8) 0%, transparent 35%),
    radial-gradient(circle at 70% 65%, rgba(34,211,238,0.7) 0%, transparent 40%),
    radial-gradient(circle at 55% 45%, rgba(129,140,248,0.5) 0%, transparent 50%);
  animation: blob 12s ease-in-out infinite alternate;
}
.story-visual .story-badge {
  position: absolute;
  bottom: 24px; left: 24px;
  background: rgba(5, 6, 15, 0.7);
  backdrop-filter: blur(10px);
  border: 1px solid var(--border-strong);
  padding: 14px 22px;
  border-radius: 14px;
  font-weight: 600;
  font-size: 0.9rem;
  display: flex;
  align-items: center;
  gap: 10px;
}

.stats-band {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 22px;
}
.stat-box {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 36px 20px;
  text-align: center;
  transition: all 0.4s ease;
}
.stat-box:hover { transform: translateY(-6px); border-color: rgba(34, 211, 238, 0.45); }
.stat-box .num {
  font-family: var(--font-head);
  font-size: clamp(1.9rem, 3.6vw, 2.6rem);
  font-weight: 700;
  background: var(--grad-text);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
.stat-box .lbl { color: var(--text-faint); font-size: 0.88rem; margin-top: 6px; }

/* timeline */
.timeline { position: relative; max-width: 760px; margin: 0 auto; }
.timeline::before {
  content: '';
  position: absolute;
  left: 50%; top: 0; bottom: 0;
  width: 2px;
  transform: translateX(-50%);
  background: linear-gradient(180deg, transparent, rgba(124, 92, 255, 0.5) 12%, rgba(34, 211, 238, 0.5) 88%, transparent);
}
.tl-item {
  position: relative;
  width: 50%;
  padding: 0 44px 54px 0;
}
.tl-item:nth-child(even) { margin-left: 50%; padding: 0 0 54px 44px; }
.tl-dot {
  position: absolute;
  top: 4px;
  right: -9px;
  width: 18px; height: 18px;
  border-radius: 50%;
  background: var(--grad-main);
  box-shadow: 0 0 16px rgba(124, 92, 255, 0.7);
  z-index: 2;
}
.tl-item:nth-child(even) .tl-dot { right: auto; left: -9px; }
.tl-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 24px;
  transition: all 0.4s ease;
}
.tl-card:hover { transform: translateY(-5px); border-color: rgba(124, 92, 255, 0.45); }
.tl-year {
  font-family: var(--font-head);
  font-weight: 700;
  color: var(--cyan);
  font-size: 0.9rem;
  letter-spacing: 1px;
  margin-bottom: 8px;
}
.tl-card h3 { font-family: var(--font-head); font-size: 1.1rem; margin-bottom: 6px; }
.tl-card p { color: var(--text-dim); font-size: 0.88rem; }

/* values */
.values-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 26px;
}
.value-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 36px 30px;
  text-align: center;
  transition: all 0.4s ease;
}
.value-card:hover { transform: translateY(-7px); border-color: rgba(129, 140, 248, 0.4); }
.value-card .v-icon {
  font-size: 2.2rem;
  margin-bottom: 16px;
  display: inline-block;
  animation: float 4.5s ease-in-out infinite;
}
.value-card h3 { font-family: var(--font-head); margin-bottom: 10px; }
.value-card p { color: var(--text-dim); font-size: 0.92rem; }

/* team */
.team-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 26px;
}
.team-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 34px 24px;
  text-align: center;
  transition: all 0.45s cubic-bezier(0.22, 1, 0.36, 1);
}
.team-card:hover { transform: translateY(-9px); border-color: rgba(124, 92, 255, 0.5); box-shadow: 0 20px 50px rgba(0,0,0,0.45); }
.team-avatar {
  width: 86px; height: 86px;
  margin: 0 auto 18px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-family: var(--font-head);
  font-size: 1.7rem;
  font-weight: 700;
  color: #fff;
  position: relative;
}
.team-avatar::after {
  content: '';
  position: absolute; inset: -5px;
  border-radius: 50%;
  border: 2px dashed rgba(124, 92, 255, 0.5);
  animation: spin 14s linear infinite;
}
.team-card h3 { font-family: var(--font-head); font-size: 1.08rem; }
.team-card .t-role { color: var(--cyan); font-size: 0.82rem; margin: 4px 0 12px; }
.team-card p { color: var(--text-faint); font-size: 0.85rem; }

/* ---------- 16. Services page ---------- */
.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 26px;
}
.service-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 36px 30px;
  transition: all 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  position: relative;
  overflow: hidden;
}
.service-card:hover { transform: translateY(-9px); border-color: rgba(34, 211, 238, 0.45); box-shadow: 0 22px 55px rgba(0,0,0,0.5); }
.service-card .feature-icon { background: rgba(34, 211, 238, 0.1); border-color: rgba(34, 211, 238, 0.35); }
.service-card .feature-icon svg { color: var(--cyan); }
.service-card:hover .feature-icon { background: var(--grad-main); }
.service-card:hover .feature-icon svg { color: #fff; }
.service-card h3 { font-family: var(--font-head); font-size: 1.2rem; margin-bottom: 10px; }
.service-card p { color: var(--text-dim); font-size: 0.94rem; margin-bottom: 18px; }
.service-card ul { display: grid; gap: 9px; }
.service-card ul li {
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 0.88rem;
  color: var(--text-dim);
}
.service-card ul li svg { width: 16px; height: 16px; color: var(--green); flex-shrink: 0; }

/* style presets */
.preset-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
.preset-card {
  border-radius: var(--radius);
  overflow: hidden;
  border: 1px solid var(--border);
  cursor: pointer;
  transition: all 0.4s ease;
  position: relative;
}
.preset-card:hover { transform: translateY(-7px); border-color: rgba(124, 92, 255, 0.5); box-shadow: 0 18px 45px rgba(0,0,0,0.5); }
.preset-card .art { aspect-ratio: 1/1; }
.preset-card .p-name {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  padding: 30px 16px 12px;
  background: linear-gradient(transparent, rgba(0,0,0,0.85));
  font-weight: 600;
  font-size: 0.9rem;
}
.preset-card .p-hot {
  position: absolute;
  top: 12px; right: 12px;
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  padding: 5px 12px;
  border-radius: 999px;
  background: rgba(129, 140, 248, 0.9);
  color: #fff;
  animation: pulseGlow 2s ease infinite;
}

/* pipeline */
.pipeline { max-width: 800px; margin: 0 auto; display: grid; gap: 18px; }
.pipeline-step {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 22px;
  align-items: flex-start;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 26px 28px;
  transition: all 0.4s ease;
}
.pipeline-step:hover { transform: translateX(8px); border-color: rgba(124, 92, 255, 0.45); }
.pipeline-step .p-num {
  width: 44px; height: 44px;
  border-radius: 12px;
  background: var(--grad-main);
  display: grid;
  place-items: center;
  font-family: var(--font-head);
  font-weight: 700;
  box-shadow: var(--shadow-glow);
}
.pipeline-step h3 { font-family: var(--font-head); font-size: 1.08rem; margin-bottom: 6px; }
.pipeline-step p { color: var(--text-dim); font-size: 0.92rem; }

/* ---------- 17. Premium page ---------- */
.pricing-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(255px, 1fr));
  gap: 28px;
  align-items: stretch;
}
.price-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 40px 32px;
  display: flex;
  flex-direction: column;
  position: relative;
  transition: all 0.45s cubic-bezier(0.22, 1, 0.36, 1);
}
.price-card:hover { transform: translateY(-10px); box-shadow: 0 26px 60px rgba(0,0,0,0.55); }
.price-card.popular {
  border-color: rgba(212, 175, 55, 0.55);
  background: linear-gradient(180deg, rgba(212, 175, 55, 0.1), var(--bg-card) 45%);
  box-shadow: 0 0 55px rgba(212, 175, 55, 0.22), 0 18px 50px rgba(0, 0, 0, 0.5);
  transform: scale(1.04);
  z-index: 2;
}
.price-card.popular:hover { transform: scale(1.04) translateY(-10px); }
.popular-flag {
  position: absolute;
  top: -16px; left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #e6c46b 0%, #d4af37 45%, #b8860b 100%);
  color: #1a1400;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  padding: 8px 22px;
  border-radius: 999px;
  box-shadow: 0 6px 26px rgba(212, 175, 55, 0.45);
  white-space: nowrap;
}
.price-card.lifetime {
  border-color: rgba(129, 140, 248, 0.45);
  background: linear-gradient(180deg, rgba(129, 140, 248, 0.08), #0e1024 45%);
  box-shadow: 0 0 45px rgba(129, 140, 248, 0.16), 0 18px 50px rgba(0, 0, 0, 0.5);
}
.lifetime-flag {
  position: absolute;
  top: -16px; left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #7c5cff 0%, #818cf8 60%, #a5b4fc 100%);
  color: #fff;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  padding: 8px 22px;
  border-radius: 999px;
  box-shadow: 0 6px 26px rgba(124, 92, 255, 0.5);
  white-space: nowrap;
}
.price-features li.gold { color: #e6c46b; }
.price-name { font-family: var(--font-head); font-weight: 700; font-size: 1.15rem; }
.price-desc { color: var(--text-faint); font-size: 0.85rem; margin: 6px 0 24px; }
.price-tag {
  display: flex;
  align-items: baseline;
  gap: 6px;
  margin-bottom: 26px;
}
.price-tag .cur { font-size: 1.3rem; font-weight: 700; color: var(--text-dim); }
.price-tag .amt {
  font-family: var(--font-head);
  font-size: 3.1rem;
  font-weight: 700;
  letter-spacing: -1.5px;
  background: var(--grad-text);
  background-size: 200% auto;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: gradientShift 6s ease infinite;
}
.price-tag .per { color: var(--text-faint); font-size: 0.9rem; }
.price-features { display: grid; gap: 13px; margin-bottom: 30px; flex: 1; }
.price-features li {
  display: flex;
  align-items: flex-start;
  gap: 11px;
  font-size: 0.9rem;
  color: var(--text-dim);
}
.price-features li svg { width: 18px; height: 18px; color: var(--green); flex-shrink: 0; margin-top: 2px; }
.price-features li.off { opacity: 0.4; }
.price-features li.off svg { color: var(--text-faint); }
.price-note { font-size: 0.78rem; color: var(--text-faint); text-align: center; margin-top: 14px; }

/* compare table */
.compare-wrap { overflow-x: auto; border-radius: var(--radius-lg); border: 1px solid var(--border); }
.compare-table { width: 100%; border-collapse: collapse; min-width: 640px; }
.compare-table th, .compare-table td {
  padding: 18px 24px;
  text-align: center;
  font-size: 0.92rem;
}
.compare-table thead th {
  font-family: var(--font-head);
  font-size: 1rem;
  color: #fff;
  border-bottom: 1px solid var(--border-strong);
  background: rgba(124, 92, 255, 0.07);
}
.compare-table thead th:first-child { text-align: left; color: var(--text-faint); font-size: 0.9rem; }
.compare-table tbody td { border-bottom: 1px solid var(--border); color: var(--text-dim); }
.compare-table tbody td:first-child { text-align: left; font-weight: 500; color: var(--text); }
.compare-table tbody tr:last-child td { border-bottom: none; }
.compare-table tbody tr { transition: background 0.3s ease; }
.compare-table tbody tr:hover { background: rgba(255, 255, 255, 0.03); }
.compare-table .yes { color: var(--green); font-weight: 700; }
.compare-table .no { color: var(--text-faint); }
.compare-table .col-popular { position: relative; background: rgba(124, 92, 255, 0.06); }
.compare-table .mini-badge {
  display: inline-block;
  font-size: 0.62rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--violet-soft);
  border: 1px solid rgba(124, 92, 255, 0.5);
  border-radius: 999px;
  padding: 3px 10px;
  margin-left: 6px;
}

/* FAQ */
.faq-list { max-width: 780px; margin: 0 auto; display: grid; gap: 16px; }
.faq-item {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  transition: border-color 0.35s ease;
}
.faq-item.open { border-color: rgba(124, 92, 255, 0.5); }
.faq-q {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 22px 26px;
  font-family: var(--font-head);
  font-weight: 600;
  font-size: 1.02rem;
  text-align: left;
  transition: color 0.3s ease;
}
.faq-q:hover { color: var(--violet-soft); }
.faq-q .f-icon {
  width: 30px; height: 30px;
  flex-shrink: 0;
  border-radius: 50%;
  border: 1px solid var(--border-strong);
  display: grid;
  place-items: center;
  transition: all 0.4s ease;
}
.faq-q .f-icon svg { width: 14px; height: 14px; transition: transform 0.4s ease; }
.faq-item.open .f-icon { background: var(--grad-main); border-color: transparent; transform: rotate(180deg); }
.faq-a {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.45s cubic-bezier(0.22, 1, 0.36, 1);
}
.faq-a p { padding: 0 26px 24px; color: var(--text-dim); font-size: 0.94rem; }

/* ---------- 18. Modal ---------- */
.modal-overlay {
  position: fixed; inset: 0;
  background: rgba(4, 4, 10, 0.78);
  backdrop-filter: blur(8px);
  display: grid;
  place-items: center;
  z-index: 2000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.4s ease;
  padding: 20px;
}
.modal-overlay.show { opacity: 1; visibility: visible; }
.modal {
  width: min(460px, 100%);
  background: var(--bg-card);
  border: 1px solid rgba(124, 92, 255, 0.45);
  border-radius: var(--radius-lg);
  padding: 40px 34px 34px;
  text-align: center;
  position: relative;
  transform: translateY(34px) scale(0.94);
  transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  box-shadow: 0 30px 90px rgba(0, 0, 0, 0.7), var(--shadow-glow);
}
.modal-overlay.show .modal { transform: translateY(0) scale(1); }
.modal-close {
  position: absolute;
  top: 14px; right: 14px;
  width: 36px; height: 36px;
  border-radius: 50%;
  border: 1px solid var(--border);
  display: grid;
  place-items: center;
  color: var(--text-faint);
  transition: all 0.3s ease;
}
.modal-close:hover { color: #fff; border-color: var(--pink); transform: rotate(90deg); }
.modal .m-icon {
  width: 72px; height: 72px;
  margin: 0 auto 20px;
  border-radius: 50%;
  background: var(--grad-main);
  display: grid;
  place-items: center;
  box-shadow: var(--shadow-glow);
  animation: float 3.5s ease-in-out infinite;
}
.modal .m-icon svg { width: 32px; height: 32px; color: #fff; }
.modal h3 { font-family: var(--font-head); font-size: 1.5rem; margin-bottom: 12px; }
.modal p { color: var(--text-dim); font-size: 0.95rem; margin-bottom: 26px; }
.modal .m-note { font-size: 0.78rem; color: var(--text-faint); margin-top: 16px; }

/* ---------- 19. Footer ---------- */
.footer {
  background: var(--bg-soft);
  border-top: 1px solid var(--border);
  padding: 80px 0 0;
  position: relative;
  overflow: hidden;
}
.footer::before {
  content: '';
  position: absolute;
  top: -140px; left: 50%;
  transform: translateX(-50%);
  width: 560px; height: 280px;
  background: radial-gradient(ellipse, rgba(124, 92, 255, 0.16), transparent 70%);
  pointer-events: none;
}
.footer-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr 1.4fr;
  gap: 48px;
  padding-bottom: 56px;
  position: relative;
}
.footer-brand p { color: var(--text-dim); font-size: 0.9rem; margin: 18px 0 24px; max-width: 300px; }
.footer-social { display: flex; gap: 12px; }
.footer-social a {
  width: 42px; height: 42px;
  border-radius: 12px;
  border: 1px solid var(--border);
  display: grid;
  place-items: center;
  color: var(--text-dim);
  transition: all 0.35s ease;
}
.footer-social a:hover {
  color: #fff;
  border-color: var(--violet);
  background: rgba(124, 92, 255, 0.15);
  transform: translateY(-4px);
  box-shadow: 0 8px 22px rgba(124, 92, 255, 0.3);
}
.footer-social svg { width: 18px; height: 18px; }
.footer-col h4 {
  font-family: var(--font-head);
  font-size: 0.95rem;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--text);
  margin-bottom: 22px;
}
.footer-col ul { display: grid; gap: 12px; }
.footer-col ul a {
  color: var(--text-dim);
  font-size: 0.92rem;
  transition: all 0.3s ease;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.footer-col ul a::before {
  content: '';
  width: 0;
  height: 2px;
  border-radius: 2px;
  background: var(--grad-main);
  transition: width 0.3s ease;
}
.footer-col ul a:hover { color: var(--text); }
.footer-col ul a:hover::before { width: 14px; }
.footer-news p { color: var(--text-dim); font-size: 0.88rem; margin-bottom: 18px; }
.news-form { display: flex; gap: 10px; }
.news-form input {
  flex: 1;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 12px 20px;
  color: var(--text);
  font-size: 0.9rem;
  transition: all 0.3s ease;
  min-width: 0;
}
.news-form input:focus { outline: none; border-color: var(--violet); box-shadow: 0 0 0 3px rgba(124, 92, 255, 0.18); }
.news-form button {
  width: 48px; height: 48px;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--grad-btn);
  color: #fff;
  display: grid;
  place-items: center;
  transition: all 0.35s ease;
}
.news-form button:hover { transform: translateY(-3px) scale(1.05); box-shadow: var(--shadow-glow); }
.footer-bottom {
  border-top: 1px solid var(--border);
  padding: 24px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  flex-wrap: wrap;
  font-size: 0.85rem;
  color: var(--text-faint);
}
.footer-bottom a { color: var(--text-dim); }
.footer-bottom a:hover { color: var(--violet-soft); }
.footer-bottom .fb-links { display: flex; gap: 22px; }

/* ---------- 20. Back to top ---------- */
.to-top {
  position: fixed;
  bottom: 28px; right: 28px;
  width: 50px; height: 50px;
  border-radius: 50%;
  background: var(--grad-btn);
  color: #fff;
  display: grid;
  place-items: center;
  box-shadow: 0 10px 30px rgba(91, 140, 255, 0.45);
  z-index: 900;
  opacity: 0;
  visibility: hidden;
  transform: translateY(16px);
  transition: all 0.4s ease;
}
.to-top.visible { opacity: 1; visibility: visible; transform: translateY(0); }
.to-top:hover { transform: translateY(-4px); box-shadow: 0 14px 40px rgba(91, 140, 255, 0.6); }
.to-top svg { width: 20px; height: 20px; }

/* ---------- 21. Scroll reveal ---------- */
.reveal {
  opacity: 0;
  transform: translateY(38px);
  transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
              transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  will-change: opacity, transform;
}
.reveal.visible { opacity: 1; transform: translateY(0); }
.reveal-left { transform: translateX(-46px); }
.reveal-left.visible { transform: translateX(0); }
.reveal-right { transform: translateX(46px); }
.reveal-right.visible { transform: translateX(0); }
.reveal-zoom { transform: scale(0.88); }
.reveal-zoom.visible { transform: scale(1); }
.d-1 { transition-delay: 0.08s; }
.d-2 { transition-delay: 0.16s; }
.d-3 { transition-delay: 0.24s; }
.d-4 { transition-delay: 0.32s; }
.d-5 { transition-delay: 0.4s; }
.d-6 { transition-delay: 0.48s; }

/* ---------- 22. Keyframes ---------- */
@keyframes gradientShift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16px); }
}
@keyframes pulseGlow {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
@keyframes shine {
  0% { left: -80%; }
  55%, 100% { left: 130%; }
}
@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}
@keyframes blob {
  0% { transform: translate(0, 0) scale(1); }
  33% { transform: translate(4%, -6%) scale(1.12); }
  66% { transform: translate(-5%, 4%) scale(0.94); }
  100% { transform: translate(2%, 3%) scale(1.06); }
}
@keyframes fadeScale {
  from { opacity: 0; transform: scale(0.94); }
  to { opacity: 1; transform: scale(1); }
}
@keyframes arrowNudge {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(6px); }
}

/* ---------- 23. Responsive ---------- */
@media (max-width: 1024px) {
  .hero-inner { grid-template-columns: 1fr; gap: 70px; }
  .hero-visual { max-width: 560px; margin: 0 auto; width: 100%; }
  .features-grid, .services-grid { grid-template-columns: repeat(2, 1fr); }
  .gallery-grid, .preset-grid { grid-template-columns: repeat(3, 1fr); }
  .team-grid { grid-template-columns: repeat(2, 1fr); }
  .stats-band { grid-template-columns: repeat(2, 1fr); }
  .footer-grid { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 768px) {
  .section { padding: 80px 0; }
  .nav-links {
    position: fixed;
    top: 0; right: -100%;
    width: min(320px, 82%);
    height: 100vh;
    background: rgba(10, 10, 20, 0.97);
    backdrop-filter: blur(20px);
    border-left: 1px solid var(--border);
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    padding: 110px 30px 40px;
    gap: 8px;
    transition: right 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 1001;
  }
  .nav-links.open { right: 0; }
  .nav-links a { width: 100%; padding: 14px 20px; font-size: 1.05rem; }
  .hamburger { display: grid; }
  .nav-cta .btn { display: none; }
  .nav-cta .plan-badge { display: none; }

  .generator-wrap { grid-template-columns: 1fr; }
  .gen-output-frame { min-height: 300px; }
  .steps { grid-template-columns: 1fr; }
  .step-arrow { display: none; }
  .features-grid, .services-grid, .testi-grid, .values-grid, .pricing-grid { grid-template-columns: 1fr; }
  .price-card.popular { transform: none; }
  .price-card.popular:hover { transform: translateY(-10px); }
  .gallery-grid, .preset-grid { grid-template-columns: repeat(2, 1fr); }
  .about-story-grid { grid-template-columns: 1fr; }
  .timeline::before { left: 9px; }
  .tl-item, .tl-item:nth-child(even) { width: 100%; margin-left: 0; padding: 0 0 40px 40px; }
  .tl-dot, .tl-item:nth-child(even) .tl-dot { left: 0; right: auto; }
  .footer-grid { grid-template-columns: 1fr; gap: 38px; }
  .hero-stats { gap: 28px; }
}

@media (max-width: 520px) {
  .gallery-grid, .preset-grid, .team-grid, .stats-band { grid-template-columns: 1fr; }
  .gen-row { grid-template-columns: 1fr; }
  .cta-banner { padding: 50px 24px; }
  .hero-actions .btn { width: 100%; }
  .footer-bottom { justify-content: center; text-align: center; }
}

/* ============================================================
   Launch Offer — ribbon, banner, countdown, trust, payments
   ============================================================ */

/* Announcement ribbon (home page top) */
.offer-ribbon {
  position: relative;
  z-index: 6;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  flex-wrap: wrap;
  padding: 10px 18px;
  text-align: center;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: .2px;
  color: #1a1400;
  background: linear-gradient(90deg, #e6c46b 0%, #e6c46b 30%, #d4af37 55%, #e6c46b 100%);
  background-size: 200% 100%;
  animation: ribbon-shine 5s linear infinite;
}
.offer-ribbon a {
  color: #1a1400;
  font-weight: 700;
  text-decoration: underline;
  text-underline-offset: 3px;
}
@keyframes ribbon-shine {
  0% { background-position: 0% 0; }
  100% { background-position: 200% 0; }
}

/* Big offer banner (pricing page) */
.offer-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28px;
  flex-wrap: wrap;
  margin: 0 auto 46px;
  max-width: 920px;
  padding: 26px 34px;
  border-radius: 20px;
  border: 1px solid rgba(212, 175, 55, .5);
  background:
    radial-gradient(600px 200px at 15% 0%, rgba(212, 175, 55, .18), transparent 60%),
    radial-gradient(600px 200px at 85% 100%, rgba(129, 140, 248, .12), transparent 60%),
    #0e1024;
  box-shadow: 0 0 55px rgba(212, 175, 55, .16);
}
.offer-copy { text-align: left; }
.offer-copy h3 {
  margin: 0 0 6px;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 22px;
  color: #fff;
}
.offer-copy h3 .hl {
  background: linear-gradient(135deg, #e6c46b 0%, #d4af37 50%, #b8860b 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}
.offer-copy p { margin: 0; font-size: 15px; color: rgba(255, 255, 255, .72); }
.offer-countdown { display: flex; gap: 10px; }
.cd-box {
  min-width: 62px;
  padding: 10px 8px 8px;
  border-radius: 14px;
  text-align: center;
  background: rgba(5, 6, 15, .6);
  border: 1px solid rgba(212, 175, 55, .35);
}
.cd-num {
  display: block;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 24px;
  font-weight: 700;
  color: #e6c46b;
}
.cd-lbl {
  display: block;
  margin-top: 2px;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: rgba(255, 255, 255, .55);
}

/* Save badge + old price + offer line on pricing cards */
.price-card { position: relative; }
.save-badge {
  position: absolute;
  top: -13px;
  right: 18px;
  z-index: 2;
  padding: 5px 12px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
  color: #1a1400;
  background: linear-gradient(135deg, #e6c46b 0%, #d4af37 60%, #b8860b 100%);
  box-shadow: 0 4px 16px rgba(212, 175, 55, .45);
}
.price-tag .old {
  display: block;
  font-size: 15px;
  color: rgba(255, 255, 255, .42);
  text-decoration: line-through;
}
.offer-line {
  margin-top: 14px;
  padding: 9px 12px;
  border-radius: 10px;
  text-align: center;
  font-size: 13px;
  font-weight: 700;
  color: #1a1400;
  background: linear-gradient(90deg, #e6c46b, #e6c46b);
}

/* Trust badges + payment methods */
.trust-bar {
  display: flex;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
  margin-top: 42px;
}
.trust-badge {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 12px 20px;
  border-radius: 14px;
  background: #0e1024;
  border: 1px solid rgba(255, 255, 255, .08);
  font-size: 14px;
  font-weight: 600;
  color: rgba(255, 255, 255, .88);
}
.trust-badge .tb-ico { font-size: 16px; }
.pay-methods {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 22px;
  font-size: 13px;
  color: rgba(255, 255, 255, .6);
}
.pay-pill {
  padding: 7px 15px;
  border-radius: 9px;
  border: 1px solid rgba(255, 255, 255, .12);
  background: #0e1024;
  font-weight: 700;
  color: rgba(255, 255, 255, .85);
}

/* CTA trust line */
.cta-trust {
  margin-top: 18px;
  display: flex;
  justify-content: center;
  gap: 6px 16px;
  flex-wrap: wrap;
  font-size: 13px;
  color: rgba(255, 255, 255, .65);
}

/* Responsive */
@media (max-width: 640px) {
  .offer-banner { gap: 18px; padding: 22px 20px; }
  .offer-copy { text-align: center; }
  .cd-box { min-width: 52px; padding: 8px 6px 6px; }
  .cd-num { font-size: 20px; }
}
